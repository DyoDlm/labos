load('Z:\MT\systeme_asservis\SIRAu_stepResponse.mat')

K = 85;          % gain estime
tau = 0.01;      % constante de temps estimee
s = tf('s');
G = K/(1 + tau*s);
[y_ex1, t_ex1] = step(exp(-0.1*s)*G, t);


%% G moteur 
K = 4.53* 10^3;          % gain estime
tau = 8 * 10^-3;     % constante de temps estimee
s = tf('s');
G_mot = K/(1 + tau*s);
down_mot = 1 + tau*s;

%% G element 
K = 20.8*10^-3;          % gain estime
tau = 1.5*10^-4;      % constante de temps estimee
s = tf('s');
G_ele = K/(1 + tau*s);
down_ele = 1 + tau*s;

%% G mesuré
K = 10.7*10^-3;          % gain estime
G_mes = K;

%%  G_final (mot+ele+mes pour ex2 C)
K = 10.7 * 4.53 * 20.8 * 10^-3;
down = down_ele * down_mot;
G_final = K/down;

%%  Regulateur PI
kr = ;          % gain estime
;         % constante de temps estimee
s = tf('s');
G_ele = kr * (1 + tau*s);
down_ele = 1 + tau*s;

%%  G ouvert



%%  G fermé

G_cf = ...









[y_mod, t_mod] = step(G_final, t);

